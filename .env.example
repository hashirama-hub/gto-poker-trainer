# GTO Poker Trainer - Environment Configuration
# Copy to .env and modify

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost/poker_trainer

# Redis (for caching, task queue)
REDIS_URL=redis://localhost:6379/0

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Solver defaults
SOLVER_DEFAULT_ITERATIONS=25000
SOLVER_SAVE_EVERY=10000
SOLVER_REPORT_EVERY=5000

# Paths
SOLUTIONS_DIR=/home/tuanlinh/poker/solutions
MODEL_CACHE_DIR=/home/tuanlinh/poker/.model_cache

# Logging
LOG_LEVEL=INFO